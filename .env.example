# =====================================================================
# Groww AI-Powered Discovery Engine - Environment Configuration
# =====================================================================

# LLM Providers (At least one provider required for Extraction & Clustering)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Social Media & Platform API Credentials
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=GrowwDiscoveryEngine/1.0
YOUTUBE_API_KEY=your_youtube_api_key_here

# Database & Storage
DATABASE_PATH=data/database/discovery_engine.db

# Application Runtime Settings
APP_ENV=development
LOG_LEVEL=INFO
